{
  "name": "nodejs-opentelemetry-workshop",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "devtools": "autotel-devtools",
    "ex": "node scripts/run.mjs exercise",
    "sol": "node scripts/run.mjs solution",
    "check": "pnpm typecheck && pnpm lint && node scripts/check.mjs",
    "typecheck": "tsc --noEmit",
    "docs": "pnpm --filter ./docs dev",
    "docs:build": "pnpm --filter ./docs build",
    "lint": "oxlint"
  },
  "dependencies": {
    "@opentelemetry/instrumentation-pino": "0.69.0",
    "autotel": "8.2.1",
    "autotel-devtools": "31.4.2",
    "autotel-subscribers": "59.0.6",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.88.0",
    "@types/node": "^26.6.5",
    "oxlint": "1.88.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
